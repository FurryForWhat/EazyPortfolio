# EazyPortfolio V2 — Environment Variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub (for fetching user repos & commit data)
GITHUB_TOKEN=your-github-personal-access-token

# Anthropic (for analyzing repos)
ANTHROPIC_BASE_URL=https://dashscope-intl.aliyuncs.com/apps/anthropic
ANTHROPIC_API_KEY=your_dashscope_api_key
ANALYZER_MODEL=qwen3.5-plus

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Where to write the merged portfolio data
PROJECTS_JSON_PATH=../EazyPortfolio-web/projects.json